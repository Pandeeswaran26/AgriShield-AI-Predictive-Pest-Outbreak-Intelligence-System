# Database Configuration
# Fallback to local SQLite if DATABASE_URL is commented or omitted
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/agrishield

# JWT Authentication
SECRET_KEY=your-secure-random-secret-key-change-this-in-production

# SMTP Email Configuration (For Email OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Twilio SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number

# Google Gemini API Key (Optional for intelligent AI Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
